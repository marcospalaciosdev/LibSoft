PORT=5000

# Postgres config
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=your_libsoft_db
DB_HOST=localhost
DB_PORT=1234

# Session
SESSION_SECRET=libsoft_session_secret_change_in_production
SESSION_EXPIRES_IN=7d
JWT_SALT_ROUNDS=10

DATABASE_URL="postgresql://postgres:your_db_password@localhost:1234/your_libsoft_db?schema=public"

SHADOW_DATABASE_URL="postgresql://postgres:your_db_password@localhost:1234/your_libsoft_db_shadow"
